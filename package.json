{
  "name": "@rebels-ecom/ecom-designsystem",
  "version": "2.0.0",
  "private": false,
  "description": "Next generation design system",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/ecom-designsystem.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "build-storybook": "storybook build",
    "test:visual": "playwright test",
    "visual:review": "node scripts/visual-review-run.mjs",
    "test-storybook": "vitest run --project=storybook",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "beta",
    "playwright": "^1.61.1",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.9"
  },
  "repository": "https://github.com/Rebels-Ecom/ecom-designsystem",
  "publishConfig": {
    "@rebels-ecom:registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0"
  }
}
